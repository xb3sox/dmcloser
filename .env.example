# Local: npx tsx server/index.ts (API 3001), npm run dev (UI 5173)
# The compose stack also needs POSTGRES_PASSWORD: any strong random value, it
# is the database password. compose fails fast if it is missing.
POSTGRES_PASSWORD=
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3001
# UI API origin. Empty in same-origin production.
VITE_API_URL=http://localhost:3001
# Production must use Postgres and a persistent 32-byte encryption key.
DATABASE_URL=
DATABASE_SSL=false
DATA_DIR=.data
ENCRYPTION_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# OpenAI-compatible providers: set a base URL and the client switches to chat completions + JSON mode.
# DeepSeek: OPENAI_BASE_URL=https://api.deepseek.com/v1  OPENAI_MODEL=deepseek-flash  AI_TIMEOUT_MS=20000
OPENAI_BASE_URL=
AI_TIMEOUT_MS=8000
META_GRAPH_VERSION=v26.0
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_MONTHLY_PRICE=
STRIPE_STARTER_YEARLY_PRICE=
STRIPE_GROWTH_MONTHLY_PRICE=
STRIPE_GROWTH_YEARLY_PRICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Resend alternative: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend,
# SMTP_PASSWORD=<RESEND_API_KEY>. No separate Resend key is read by the app.
MAIL_FROM=DMCloser <hello@example.com>
# Worker tuning. Defaults are safe for one process; raise only after load evidence.
WORKER_CONCURRENCY=2
WORKER_KINDS=
WORKER_ENABLED=true
# Only set to 1 behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Separate internal monitoring bearer credential. Not a user/provider token.
METRICS_TOKEN=
# Optional error monitoring. Empty keeps every gate and local run a no-op.
SENTRY_DSN=
# Optional release label; falls back to COMMIT_SHA or GIT_SHA in CI.
SENTRY_RELEASE=